# ============================================================================
# Final_GRAG — environment variables template
# ============================================================================
# Copy file này thành `.env` và điền giá trị thật trước khi chạy pipeline.
# `.env` đã được liệt kê trong `.gitignore` — KHÔNG commit secret thật.
# ============================================================================

# --- Vector DB: Zilliz Cloud (Milvus) ---
# Tạo cluster free tier tại https://cloud.zilliz.com/ → tab "Connect" lấy URI + API Key.
# Bắt buộc cho Module 2 (push chunks) và Module 3 (truy vấn evidence).
ZILLIZ_CLOUD_URI=
ZILLIZ_CLOUD_API_KEY=

# --- OpenAI (chỉ dùng cho TN4 — calibrate arbiter) ---
# Module 3 main pipeline KHÔNG cần OpenAI; LLM judge dùng Ollama local (qwen3:14b).
# Chỉ cần khi chạy `experiments/module3_nli/run_arbiter.py` để re-run arbiter v1/v2/v3.
OPENAI_API_KEY=

# --- HuggingFace (download embedding/NLI weights) ---
# BGE-M3 và mDeBERTa-v3 đều public; token chỉ cần khi rate-limited hoặc model gated.
HF_TOKEN=

# --- Google Gemini (legacy / optional) ---
# Đã dùng trong giai đoạn prototype Module 1; pipeline chính hiện không phụ thuộc.
GEMINI_API_KEY=
